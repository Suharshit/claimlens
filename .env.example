# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Model lane (decided 2026-11-10): free open-weight models, tried in this order.
# Leave a key empty to skip that provider; with no keys the rule-based intake runs.

# 1) Groq — free key at https://console.groq.com/keys (no card)
GROQ_API_KEY=

# 2) NVIDIA build (Nemotron) — free key at https://build.nvidia.com (API key → nvapi-...)
NVIDIA_API_KEY=

# Optional: force rules only (tests set this automatically)
# CLAIMLENS_LLM=off
